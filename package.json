  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "npm run build && node --experimental-strip-types --test tests/pages-build.test.mjs tests/insta360-resolver.test.mjs tests/insta360.test.mts tests/permalink.test.mts tests/view-pose.test.mts tests/capture-view.test.mts tests/resolver-config.test.mts tests/sog-optimizer.test.mts",
    "lint": "eslint .",
    "resolver:dev": "wrangler dev --config resolver-worker/wrangler.toml",
    "resolver:deploy": "wrangler deploy --config resolver-worker/wrangler.toml"
  },
  "dependencies": {
    "playcanvas": "^2.21.0",
    "react": "19.2.6",
    "react-dom": "19.2.6"
  },
  "devDependencies": {
    "@eslint/js": "9.39.4",
    "@types/node": "22.19.19",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.2",
    "eslint": "9.39.4",
    "eslint-plugin-jsx-a11y": "6.10.2",
    "eslint-plugin-react": "7.37.5",
    "eslint-plugin-react-hooks": "7.1.1",
    "globals": "16.4.0",
    "typescript": "5.9.3",
    "typescript-eslint": "8.59.3",
    "vite": "8.0.13",
    "wrangler": "4.92.0"
  },
  "type": "module"
}
